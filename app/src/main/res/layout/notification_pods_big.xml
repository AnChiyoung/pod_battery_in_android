<?xml version="1.0" encoding="utf-8"?>
<!-- 펼친 알림: 기기 이름 아래에 아이콘, 이름표, 퍼센트, 게이지를 세 칸으로 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pod_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pod_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
    
            <ImageView
                android:id="@+id/left_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_pod_left"
                android:tint="@color/pod_text"
                android:importantForAccessibility="no" />
    
            <TextView
                android:id="@+id/left_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pod_text_secondary"
                android:textSize="12sp"
                android:text="왼쪽" />
    
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
    
                <TextView
                    android:id="@+id/left_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pod_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="--" />
    
                <ImageView
                    android:id="@+id/left_bolt"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bolt"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </LinearLayout>
    
            <ProgressBar
                android:id="@+id/left_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="64dp"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/pod_track"
                android:progressTint="#FF34C759" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
    
            <ImageView
                android:id="@+id/right_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_pod_right"
                android:tint="@color/pod_text"
                android:importantForAccessibility="no" />
    
            <TextView
                android:id="@+id/right_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pod_text_secondary"
                android:textSize="12sp"
                android:text="오른쪽" />
    
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
    
                <TextView
                    android:id="@+id/right_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pod_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="--" />
    
                <ImageView
                    android:id="@+id/right_bolt"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bolt"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </LinearLayout>
    
            <ProgressBar
                android:id="@+id/right_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="64dp"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/pod_track"
                android:progressTint="#FF34C759" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
    
            <ImageView
                android:id="@+id/case_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_pod_case"
                android:tint="@color/pod_text"
                android:importantForAccessibility="no" />
    
            <TextView
                android:id="@+id/case_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pod_text_secondary"
                android:textSize="12sp"
                android:text="케이스" />
    
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
    
                <TextView
                    android:id="@+id/case_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pod_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="--" />
    
                <ImageView
                    android:id="@+id/case_bolt"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bolt"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </LinearLayout>
    
            <ProgressBar
                android:id="@+id/case_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="64dp"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/pod_track"
                android:progressTint="#FF34C759" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
